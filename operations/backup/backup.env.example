# Non-secret backup configuration. Production copy: /etc/liquent/backup.env
RESTIC_REPOSITORY=s3:https://s3.REGION.io.cloud.ovh.net/BUCKET/liquent
RESTIC_PASSWORD_FILE=/run/secrets/restic_password
OVH_ACCESS_KEY_FILE=/run/secrets/ovh_access_key
OVH_SECRET_KEY_FILE=/run/secrets/ovh_secret_key
PGPASSFILE=/run/secrets/pgpass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=liquent
POSTGRES_USER=liquent
BACKUP_DATABASE_DIR=/backup-input/database
ARTIFACT_ROOT=/backup-input/artifacts
BACKUP_HOST_ID=liquent-production
LIQUENT_MIGRATION_HEAD=20260726_0001
