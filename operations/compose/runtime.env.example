# Non-secret process configuration. Copy to runtime.env on the deployment host.
# Never place credentials, tokens, DSNs, or private URLs in this file.
LIQUENT_ENVIRONMENT=production
LIQUENT_LOG_LEVEL=INFO
LIQUENT_LOG_FORMAT=json
LIQUENT_HTTP_HOST=0.0.0.0
LIQUENT_HTTP_PORT=8000
LIQUENT_ARTIFACT_ROOT=/var/lib/liquent/artifacts
LIQUENT_JOB_CONCURRENCY=1
LIQUENT_TRADING_CONNECTIVITY=disabled
# Host paths used by Compose, not values consumed from the container environment.
# The two files must be regular, current-owner-only 0400/0600 files; the data
# directory is mounted read-only. Use absolute deployment-host paths.
LIQUENT_RESEARCH_WORKER_CONFIG_FILE=/srv/liquent/config/research-worker.json
LIQUENT_RESEARCH_WORKER_ID_FILE=/srv/liquent/config/research-worker-id
LIQUENT_RESEARCH_DATA_ROOT=/srv/liquent/research-data
# OIDC is opt-in and all values below are one atomic process contract.
LIQUENT_OIDC_LOGIN_ORIGIN=https://app.example.invalid
LIQUENT_OIDC_LOGIN_LIFETIME_SECONDS=300
LIQUENT_OIDC_SESSION_LIFETIME_SECONDS=28800
LIQUENT_OIDC_CALLBACK_REJECTION=/login/rejected
LIQUENT_OIDC_CALLBACK_UNAVAILABLE=/login/unavailable
LIQUENT_OIDC_CONNECT_TIMEOUT_SECONDS=5
LIQUENT_OIDC_READ_TIMEOUT_SECONDS=10
LIQUENT_OIDC_TOTAL_TIMEOUT_SECONDS=15
LIQUENT_OIDC_TOKEN_RESPONSE_MAX_BYTES=65536
LIQUENT_OIDC_JWKS_RESPONSE_MAX_BYTES=262144
LIQUENT_OIDC_JWKS_CACHE_TTL_SECONDS=300
# Manifest-handoff supervisor settings remain intentionally inactive until the
# process-composition and deployment slices are complete. The future atomic
# group is documented here without supplying active values:
# LIQUENT_MANIFEST_HANDOFF_SUPERVISOR_MODE=candidate
# LIQUENT_MANIFEST_HANDOFF_SUPERVISOR_BACKEND_INSTANCE_ID=control-plane-a
# LIQUENT_MANIFEST_HANDOFF_SUPERVISOR_DOCKER_SOCKET=/run/docker.sock
# LIQUENT_MANIFEST_HANDOFF_SUPERVISOR_CONTROL_ROOT=/run/liquent/supervisor-control
# LIQUENT_MANIFEST_HANDOFF_SUPERVISOR_HOST_OWNER_UID=10001
# LIQUENT_MANIFEST_HANDOFF_SUPERVISOR_READER_GID=10002
# LIQUENT_MANIFEST_HANDOFF_SUPERVISOR_WRAPPER_UID=10002
# LIQUENT_MANIFEST_HANDOFF_SUPERVISOR_WRAPPER_GID=10002
