# Operator-supplied immutable production artifacts. Every image value must use
# the form registry/repository@sha256:<digest>; tags alone are not accepted.
LIQUENT_APP_IMAGE=ghcr.io/nexvero/liquent@sha256:REPLACE_WITH_RELEASE_DIGEST
LIQUENT_POSTGRES_IMAGE=postgres@sha256:4ef4dbc939d61acea57712655ddb4b4ab27419c913f94cca0cd57cb3ea3c2280
LIQUENT_PROMETHEUS_IMAGE=prom/prometheus@sha256:5ce7540c3c00ef4ab0c9d2c995c6a5b9c421f44b4a115d97a2c7af3b1c21cbb0
LIQUENT_GRAFANA_IMAGE=grafana/grafana@sha256:121a7a9ece6dc10b969f1f96eed64b4f07dfac0d0b8abc070f7cb83bbde86f63
LIQUENT_SECRETS_DIR=/opt/liquent/secrets
# Host-only Compose interpolation values. These are not passed to application processes.
LIQUENT_RESEARCH_WORKER_CONFIG_FILE=/srv/liquent/config/research-worker.json
LIQUENT_RESEARCH_WORKER_ID_FILE=/srv/liquent/config/research-worker-id
LIQUENT_RESEARCH_DATA_ROOT=/srv/liquent/research-data
