# Operator-supplied immutable production artifacts. Every image value must use
# the form registry/repository@sha256:<digest>; tags alone are not accepted.
LIQUENT_APP_IMAGE=ghcr.io/nexvero/liquent@sha256:REPLACE_WITH_RELEASE_DIGEST
LIQUENT_POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_APPROVED_POSTGRES_18_DIGEST
LIQUENT_PROMETHEUS_IMAGE=prom/prometheus@sha256:REPLACE_WITH_APPROVED_DIGEST
LIQUENT_GRAFANA_IMAGE=grafana/grafana@sha256:REPLACE_WITH_APPROVED_DIGEST
LIQUENT_BACKUP_IMAGE=ghcr.io/nexvero/liquent-backup@sha256:REPLACE_WITH_RELEASE_DIGEST
LIQUENT_SECRETS_DIR=/opt/liquent/secrets
