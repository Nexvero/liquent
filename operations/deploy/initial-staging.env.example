# Root-owned mode 0600. This file contains paths and public routing metadata,
# never certificate material or credentials.
STAGING_HOST=staging.liquent.ai
EXPECTED_IPV4=REPLACE_WITH_VPS_IPV4
EDGE_COMPOSE_FILE=/opt/liquent/edge/compose.edge.yaml
EDGE_ENV_FILE=/opt/liquent/edge/edge.env
EDGE_CONFIG_FILE=/opt/liquent/edge/conf.d/reverse-proxy.conf
EDGE_CERT_FILE=/opt/liquent/edge/certs/fullchain.pem
EDGE_KEY_FILE=/opt/liquent/edge/certs/privkey.pem
