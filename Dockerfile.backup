# The manifest-list digests are authoritative; tags document reviewed versions.
ARG POSTGRES_IMAGE=postgres:18.6-trixie@sha256:4ef4dbc939d61acea57712655ddb4b4ab27419c913f94cca0cd57cb3ea3c2280
ARG RESTIC_IMAGE=restic/restic:0.18.1@sha256:39d9072fb5651c80d75c7a811612eb60b4c06b32ffe87c2e9f3c7222e1797e76

FROM ${RESTIC_IMAGE} AS restic

FROM ${POSTGRES_IMAGE} AS runtime
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="Liquent Backup" \
      org.opencontainers.image.description="Liquent PostgreSQL and artifact backup runtime" \
      org.opencontainers.image.source="https://github.com/Nexvero/liquent" \
      org.opencontainers.image.revision="${VCS_REF}"

COPY --from=restic /usr/bin/restic /usr/local/bin/restic
COPY operations/backup/ /opt/liquent/backup/

RUN groupadd --gid 10001 liquent-backup \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent \
        --shell /usr/sbin/nologin liquent-backup \
    && chmod 0555 /opt/liquent/backup/*.sh /usr/local/bin/restic

USER 10001:10001
WORKDIR /backup-input
ENTRYPOINT []
CMD ["/opt/liquent/backup/backup.sh", "--check"]
