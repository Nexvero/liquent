# The manifest-list digests are authoritative; tags document reviewed versions.
ARG POSTGRES_IMAGE=postgres:18.6-trixie@sha256:4ef4dbc939d61acea57712655ddb4b4ab27419c913f94cca0cd57cb3ea3c2280
ARG GO_IMAGE=golang:1.26.6-trixie@sha256:b75d466dd608587fd66cca705a307ba65b889827d06ad61d6a75f0482b51b7c7

FROM ${GO_IMAGE} AS restic
ARG RESTIC_VERSION=0.19.1
ARG RESTIC_SOURCE_SHA256=bb9b1a19040744d26d8a79be029d4e6b189c45ccc9d8831d7fe367d3c33df725
ADD --checksum=sha256:${RESTIC_SOURCE_SHA256} \
    https://github.com/restic/restic/archive/refs/tags/v${RESTIC_VERSION}.tar.gz \
    /tmp/restic.tar.gz
RUN mkdir /src /out \
    && tar --extract --gzip --file /tmp/restic.tar.gz --directory /src --strip-components=1 \
    && cd /src \
    && go get \
        golang.org/x/crypto@v0.56.0 \
        golang.org/x/net@v0.57.0 \
        golang.org/x/text@v0.39.0 \
        google.golang.org/grpc@v1.83.1 \
    && go mod tidy \
    && go run build.go -o /out/restic

FROM ${POSTGRES_IMAGE} AS runtime
ARG VCS_REF=unknown
ARG OPENSSL_VERSION=3.5.7-1~deb13u2
LABEL org.opencontainers.image.title="Liquent Backup" \
      org.opencontainers.image.description="Liquent PostgreSQL and artifact backup runtime" \
      org.opencontainers.image.source="https://github.com/Nexvero/liquent" \
      org.opencontainers.image.revision="${VCS_REF}"

COPY --from=restic /out/restic /usr/local/bin/restic
COPY operations/backup/ /opt/liquent/backup/

RUN apt-get update \
    && apt-get install --yes --no-install-recommends --only-upgrade \
        "libssl3t64=${OPENSSL_VERSION}" \
        "openssl=${OPENSSL_VERSION}" \
        "openssl-provider-legacy=${OPENSSL_VERSION}" \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/local/bin/gosu \
    && groupadd --gid 10001 liquent-backup \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent \
        --shell /usr/sbin/nologin liquent-backup \
    && chmod 0555 /opt/liquent/backup/*.sh /usr/local/bin/restic

USER 10001:10001
WORKDIR /backup-input
ENTRYPOINT []
CMD ["/opt/liquent/backup/backup.sh", "--check"]
